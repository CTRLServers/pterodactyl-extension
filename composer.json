{
    "name": "ctrlservers/pterodactyl-extension",
    "description": "Adds a client dashboard action to import Pterodactyl servers into CTRLServers Desktop.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/CTRLServers/pterodactyl-extension",
    "keywords": [
        "pterodactyl",
        "ctrlservers",
        "laravel",
        "client-api"
    ],
    "authors": [
        {
            "name": "CTRLServers",
            "homepage": "https://github.com/CTRLServers"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "CTRLServers\\PterodactylExtension\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CTRLServers\\PterodactylExtension\\CTRLServersServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
